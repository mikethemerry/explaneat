digraph {
	graph [dpi=150 rankdir=LR]
	-1 [label="in-1\nr=0 (8x8)" fillcolor="#cfe8ff" fontcolor=black shape=box style=filled]
	0 [label="out0\nr=0 (8x8)" fillcolor="#cfe8ff" fontcolor=black shape=box style=filled]
	1 [label="h1\nr=1 (4x4)" fillcolor="#ffe2b8" fontcolor=black shape=ellipse style=filled]
	2 [label="h2\nr=2 (2x2)" fillcolor="#d9f2d0" fontcolor=black shape=ellipse style=filled]
	-1 -> 1 [label="k=3" color=black penwidth=3.5]
	1 -> 2 [label="k=3" color=black penwidth=3.5]
	2 -> 0 [label="k=3" color=black penwidth=3.5]
}
